{{!-- VM fragment (server and instance tabs, VM route): one block per VM. Every value is escaped ({{ }} only). No scripts:
     the buttons are handled by vm-tuneup.js (delegated, scoped to .vm-tuneup-tab). --}}
<div class="vm-tuneup vtu-vm">
<style>
.vm-tuneup { font-size: 13px; padding: 6px 0; }
.vm-tuneup h4 { margin: 14px 0 6px; font-size: 14px; }
.vm-tuneup .vtu-muted { opacity: .7; }
.vm-tuneup .vtu-head { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 8px; }
.vm-tuneup .vtu-grade { display: inline-block; min-width: 34px; text-align: center; font-weight: 700; font-size: 18px; padding: 4px 8px; border-radius: 4px; color: #fff; }
.vm-tuneup .vtu-grade-small { font-size: 12px; min-width: 22px; padding: 1px 6px; }
.vm-tuneup .vtu-grade-a { background: #2e7d32; } .vm-tuneup .vtu-grade-b { background: #558b2f; }
.vm-tuneup .vtu-grade-c { background: #b8860b; } .vm-tuneup .vtu-grade-d { background: #d2691e; }
.vm-tuneup .vtu-grade-f { background: #c62828; }
.vm-tuneup .vtu-badge { display: inline-block; font-size: 11px; padding: 1px 6px; border-radius: 3px; border: 1px solid rgba(128,128,128,.5); margin-right: 4px; white-space: nowrap; }
.vm-tuneup .vtu-sev-critical { background: #c62828; color: #fff; border-color: #c62828; }
.vm-tuneup .vtu-sev-warning { background: #ef8f00; color: #fff; border-color: #ef8f00; }
.vm-tuneup .vtu-sev-info { background: #1e6fb8; color: #fff; border-color: #1e6fb8; }
.vm-tuneup .vtu-cat-rec { border-color: #2e7d32; }
.vm-tuneup .vtu-cat-con { border-color: #8a8f98; }
.vm-tuneup .vtu-finding { border: 1px solid rgba(128,128,128,.35); border-radius: 4px; padding: 8px 10px; margin: 8px 0; }
.vm-tuneup .vtu-finding p { margin: 4px 0; }
.vm-tuneup .vtu-finding ol, .vm-tuneup .vtu-finding ul { margin: 4px 0 4px 18px; padding: 0; }
.vm-tuneup .vtu-evidence { font-family: monospace; font-size: 12px; background: rgba(128,128,128,.1); padding: 3px 6px; border-radius: 3px; }
.vm-tuneup table.vtu-table { border-collapse: collapse; width: 100%; }
.vm-tuneup table.vtu-table th, .vm-tuneup table.vtu-table td { text-align: left; padding: 4px 8px; border-bottom: 1px solid rgba(128,128,128,.25); vertical-align: top; }
.vm-tuneup .vtu-num { text-align: right; }
.vm-tuneup details { margin: 8px 0; }
.vm-tuneup summary { cursor: pointer; font-weight: 600; }
.vm-tuneup .vtu-bar { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin: 4px 0 8px; font-size: 12px; }
.vm-tuneup .vtu-id { font-size: 11px; font-weight: normal; }
.vm-tuneup .vtu-probe-hint { font-size: 12px; opacity: .8; }
.vm-tuneup .vtu-probe-off { opacity: .55; }
.vm-tuneup .vtu-plan-box { border: 1px solid rgba(1,169,130,.45); border-radius: 4px; padding: 8px 12px; margin: 8px 0 10px; }
.vm-tuneup .vtu-plan-head { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
.vm-tuneup .vtu-plan-link { margin-left: auto; }
.vm-tuneup .vtu-plan-stage { margin: 8px 0 2px; font-weight: 600; }
.vm-tuneup .vtu-plan-box ol { margin: 2px 0 4px 20px; padding: 0; }
.vm-tuneup .vtu-acts { display: grid; grid-template-columns: 170px minmax(0, 1fr); column-gap: 10px; row-gap: 4px; align-items: center; margin: 4px 0 10px; font-size: 12px; }
.vm-tuneup .vtu-act-row { display: contents; }
.vm-tuneup .vtu-act-btn { grid-column: 1; }
.vm-tuneup .vtu-act-btn .btn { width: 100%; }
.vm-tuneup .vtu-act-state { grid-column: 2; }
.vm-tuneup .vtu-act-detail { grid-column: 2; margin-bottom: 6px; }
.vm-tuneup .vtu-note { padding: 8px 10px; border-left: 3px solid #8a8f98; background: rgba(128,128,128,.08); margin: 8px 0; }
</style>
{{#if error}}<div class="vtu-note">{{error}}</div>{{/if}}
{{#each vms}}
<div class="vtu-vm-block"{{#if guestRunning}} data-vtu-poll="1"{{/if}}>
	<div class="vtu-acts">
	<div class="vtu-act-row">
		<div class="vtu-act-btn"><button type="button" class="btn btn-default btn-xs vtu-act" data-vtu-action="vm-refresh">Refresh</button></div>
		<div class="vtu-act-state"><span class="vtu-muted">Scanned {{scannedAgo}}.</span> <span class="vtu-act-status vtu-muted"></span></div>
	</div>
	{{#if probeShown}}
	<div class="vtu-act-row vtu-probe">
		{{#if probeReported}}<div class="vtu-act-btn"></div><div class="vtu-act-state vtu-muted">{{probeReported}}</div>{{else}}
		<div class="vtu-act-btn">{{#if canProbe}}<button type="button" class="btn btn-default btn-xs vtu-act" data-vtu-action="vm-probe" title="20-second timeout">Check guest agent</button>{{/if}}</div>
		<div class="vtu-act-state">{{#if probeLast}}<span class="vtu-probe-last">{{probeLast}}</span>{{/if}}{{#if probeNote}} <span class="vtu-probe-note vtu-muted">{{probeNote}}</span>{{/if}}</div>
		<div class="vtu-act-detail vtu-probe-hint{{#unless canProbe}} vtu-probe-off{{/unless}}">{{probeHint}}{{#if probeLinuxNote}} {{probeLinuxNote}}{{/if}}{{#if probeDenied}} <strong>{{probeDenied}}</strong>{{/if}}</div>
		{{/if}}
	</div>
	{{/if}}
	<div class="vtu-act-row vtu-guest">
		<div class="vtu-act-btn">{{#unless guestRunning}}{{#if guestCanRun}}<button type="button" class="btn btn-default btn-xs vtu-act" data-vtu-action="vm-guest">{{#if guestAgo}}Run guest checks again{{else}}Run guest checks{{/if}}</button>{{/if}}{{/unless}}</div>
		<div class="vtu-act-state">{{#if guestRunning}}<span class="vtu-busy vtu-working" role="status">Running the guest checks inside the VM (this can take a few minutes)…</span>{{else}}
		{{#if guestAgo}}<span class="vtu-muted">Guest checked {{guestAgo}}{{#if guestOs}}: {{guestOs}}{{/if}}.</span>{{/if}}
		{{#if guestError}}<span class="vtu-muted">Last run didn't finish: {{guestError}}</span>{{/if}}{{/if}}</div>
		<div class="vtu-act-detail vtu-probe-hint{{#unless guestCanRun}} vtu-probe-off{{/unless}}">{{guestHint}}</div>
	</div>
	{{#if osFillShown}}
	<div class="vtu-act-row vtu-osfill">
		<div class="vtu-act-btn">{{#if osFillCanUpdate}}<button type="button" class="btn btn-default btn-xs vtu-act" data-vtu-action="vm-setos" data-vtu-confirm="Copy the OS the guest reported ({{osFillName}}) into the empty OS fields of this VM's Morpheus record? Fields Morpheus already has are not changed.">Fill in OS fields</button>{{/if}}</div>
		<div class="vtu-act-state">Morpheus has no {{osFillFields}} for this VM. The guest reports <strong>{{osFillName}}</strong>.</div>
		<div class="vtu-act-detail vtu-probe-hint">Fill in copies what the guest checks read from inside the VM (through its agent) into the empty OS fields of this VM's Morpheus record. Fields Morpheus already has stay as they are.{{#unless osFillCanUpdate}} Needs "VM Tune-Up: Update VM records" at full.{{/unless}}</div>
	</div>
	{{/if}}
	</div>
	{{#if problem}}
	<div class="vtu-note"><strong>{{name}}</strong>: {{problem}}</div>
	{{else}}
	{{#if skippedText}}<div class="vtu-note">Unknown: time budget. Not finished in time: {{skippedText}}. The checks that need them show unknown; use Refresh to try again.</div>{{/if}}
	<div class="vtu-head">
		<span class="vtu-grade {{gradeClass}}">{{grade}}</span>
		<div>
			<strong>{{name}}</strong> <span class="vtu-muted">score {{score}} / 100</span><br>
			<span class="vtu-muted">{{os}} &middot; {{managed}} &middot; power {{power}}{{#if cluster}} &middot; cluster {{cluster}}{{/if}}{{#if host}} &middot; host {{host}}{{/if}}</span>
		</div>
		<div>
			<span class="vtu-badge vtu-sev-critical">{{critical}} critical</span>
			<span class="vtu-badge vtu-sev-warning">{{warning}} warning</span>
			<span class="vtu-badge vtu-sev-info">{{info}} info</span>
			<span class="vtu-badge" title="{{originWhy}}">{{originLabel}}</span>
		</div>
	</div>
	{{#if hasPlan}}
	<div class="vtu-plan-box">
		<div class="vtu-plan-head"><strong>Tune-up plan:</strong> {{planWindow}}
			<span class="vtu-plan-after"><span class="vtu-grade vtu-grade-small {{gradeClass}}">{{grade}}</span> {{score}} &rarr; <span class="vtu-grade vtu-grade-small {{gradeAfterClass}}">{{gradeAfter}}</span> {{scoreAfter}}</span>
			{{#if linkUrl}}<a class="vtu-plan-link" href="{{linkUrl}}">{{linkLabel}}</a>{{/if}}</div>
		{{#if hasPlanPrepare}}<p class="vtu-plan-stage">Before the outage, in this order:</p><ol>{{#each planPrepare}}<li>{{this}}</li>{{/each}}</ol>{{/if}}
		{{#if hasPlanLive}}<p class="vtu-plan-stage">Any time, no downtime:</p><ol>{{#each planLive}}<li>{{title}} <span class="vtu-muted vtu-id">{{id}}</span><br><span class="vtu-muted">{{howInVme}}</span>{{#if hasStepPrereqs}}<ul class="vtu-muted">{{#each stepPrereqs}}<li>{{this}}</li>{{/each}}</ul>{{/if}}</li>{{/each}}</ol>{{/if}}
		{{#if hasPlanReboot}}<p class="vtu-plan-stage">With one guest restart:</p><ol>{{#each planReboot}}<li>{{title}} <span class="vtu-muted vtu-id">{{id}}</span><br><span class="vtu-muted">{{howInVme}}</span></li>{{/each}}</ol>{{/if}}
		{{#if hasPlanCold}}<p class="vtu-plan-stage">During one outage of this VM (Morpheus powers it off once), in this order:</p><ol>{{#each planCold}}<li>{{title}} <span class="vtu-muted vtu-id">{{id}}</span><br><span class="vtu-muted">{{howInVme}}</span></li>{{/each}}</ol>{{/if}}
		{{#if planConsiderations}}<p class="vtu-muted">Not in the plan: {{planConsiderations}} Consideration(s), listed below with the findings.</p>{{/if}}
	</div>
	{{else}}{{#if linkUrl}}<div class="vtu-bar"><a href="{{linkUrl}}">{{linkLabel}}</a></div>{{/if}}{{/if}}
	{{#if hasFindings}}
	<h4>Findings</h4>
	{{#each findings}}
	<div class="vtu-finding">
		<div>
			<span class="vtu-badge {{sevClass}}">{{severity}}</span>
			<span class="vtu-badge {{catClass}}">{{category}}</span>
			<strong>{{title}}</strong> <span class="vtu-muted vtu-id" title="Check ID {{fullId}}">{{id}}</span>
		</div>
		<p><span class="vtu-evidence">{{detail}}</span></p>
		{{#each notes}}<p class="vtu-muted">{{this}}</p>{{/each}}
		<p class="vtu-muted">Evidence: {{evidence}}</p>
		<p><strong>If you leave it:</strong> {{leave}}</p>
		<p><strong>If you fix it:</strong> {{fixSummary}}<br>
			Downtime: {{downtime}} &middot; Risk: {{risk}} &middot; Reversible: {{reversible}}</p>
		{{#if hasPrerequisites}}<div>Do first, in this order:<ol>{{#each prerequisites}}<li>{{this}}</li>{{/each}}</ol></div>{{/if}}
		{{#if isRecommendation}}<p><strong>How in Morpheus:</strong> {{howInVme}}</p>{{else}}<p><strong>Why it's a consideration:</strong> {{whyConsideration}}</p>{{/if}}
		{{#if hasUnverified}}<div class="vtu-muted">Not yet verified:<ul>{{#each unverified}}<li>{{this}}</li>{{/each}}</ul></div>{{/if}}
		<div class="vtu-muted">References: {{#each references}}<a href="{{url}}" target="_blank" rel="noopener noreferrer">{{label}}</a>{{#unless @last}}; {{/unless}}{{/each}}</div>
	</div>
	{{/each}}
	{{else}}
	<div class="vtu-note">No findings from the checks that could run.</div>
	{{/if}}
	{{#if hasUndecided}}
	<details>
		<summary>Unknown or not evaluated ({{undecidedCount}})</summary>
		<p class="vtu-muted">These carry no penalty: the plugin couldn't decide them for this VM or Morpheus version.</p>
		<table class="vtu-table">
		{{#each undecided}}<tr><td>{{title}} <span class="vtu-muted vtu-id" title="Check ID {{fullId}}">{{id}}</span></td><td>{{status}}</td><td>{{detail}}{{#each notes}}<br><span class="vtu-muted">{{this}}</span>{{/each}}</td></tr>{{/each}}
		</table>
	</details>
	{{/if}}
	<details>
		<summary>Passed or not applicable ({{passedCount}})</summary>
		<table class="vtu-table">
		{{#each passed}}<tr><td>{{title}} <span class="vtu-muted vtu-id" title="Check ID {{fullId}}">{{id}}</span></td><td>{{status}}</td><td>{{detail}}</td></tr>{{/each}}
		</table>
	</details>
	{{/if}}
</div>
{{/each}}
<div class="vtu-muted">{{aboutChecks}}</div>
<div class="vtu-muted">{{disclaimer}} Nothing on this tab changes the VM; Fill in OS fields only writes the empty OS fields of its Morpheus record.</div>
</div>
